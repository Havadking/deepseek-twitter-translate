{
  "manifest_version": 3,
  "name": "DeepSeek 翻译 for X / Twitter",
  "version": "1.0.0",
  "description": "用 DeepSeek 替换 X (Twitter) 自带的推文翻译功能，界面保持不变。",
  "permissions": ["storage"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
